# Copy to .env and fill in. The agent runs without these (offline mode);
# with them it uses Gemini for planning and reasoning.

# --- Option A: Vertex AI (recommended, no API key) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Option B: Gemini API key ---
# GOOGLE_API_KEY=

# Model selection
AXIOM_MODEL=gemini-2.5-pro

# ARF backend selection. Leave unset to use the default ReferenceAxiomEngine.
# To load an alternative backend, set "module.path:ClassName".
# AXIOM_ARF_ENGINE=my_package.engine:MyAxiomEngine

# Compute backend for heavy simulations: "local" (review mode) or "vertex" (Vertex AI GPU).
AXIOM_COMPUTE_BACKEND=local
# When using the Vertex backend, point at your simulation-engine container + workers.
# AXIOM_SIM_IMAGE_URI=us-docker.pkg.dev/PROJECT/axiom/simulation-engine:latest
# AXIOM_SIM_MACHINE_TYPE=a2-highgpu-1g
# AXIOM_SIM_ACCELERATOR=NVIDIA_TESLA_A100
